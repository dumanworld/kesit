{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kesit",
  "mainBinaryName": "Kesit",
  "version": "1.1.1",
  "identifier": "com.dumanworld.kesit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kesit",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0f0f10",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/ffmpeg.exe": "ffmpeg.exe",
      "bin/ffmpeg-LICENSE.txt": "ffmpeg-LICENSE.txt",
      "bin/ffmpeg-README.txt": "ffmpeg-README.txt"
    },
    "copyright": "Kesit",
    "shortDescription": "Hızlı video kesme ve kırpma",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyREI4NzI0RjlGRkY4OEEKUldTSytQLzVKSWZia3F4Y2UwRDJaQ2xnU0xTUmhPNGplOGlvd201dW1zTm5aR2NOMFN3cXF5Q0sK",
      "endpoints": [
        "https://github.com/dumanworld/kesit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
